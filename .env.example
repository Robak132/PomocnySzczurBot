# Bot token from the Discord Developer Portal
DISCORD_TOKEN=

# ID of your server (enable Developer Mode in Discord, right-click the server, Copy Server ID)
GUILD_ID=

# Optional: members holding this role count as admins (members with the
# Discord "Administrator" permission are always admins)
ADMIN_ROLE_ID=

# Optional: only members holding this role can use the bot. Everyone else gets
# "You don't have access to this bot." Leave empty to allow everyone.
ACCESS_ROLE_ID=

# Optional: channel where the bot posts a line for every change it makes
LOG_CHANNEL_ID=

# Where the SQLite database is stored
DB_PATH=bot.db
